import React,{useEffect,useState} from 'react';
import {supabase,base} from './lib/supabase.js';
const menu=[['⌂','Início'],['⌕','Explorar'],['♧','Artistas'],['▦','Categorias'],['☆','Salvos']];
function safe(url){try{const u=new URL(url);return u.protocol==='https:'?u.href:null}catch{return null}}
function Media({m}){const url=safe(m.url);if(!url)return null;const u=new URL(url);let embed=null;if(m.tipo==='youtube'){const id=u.hostname==='youtu.be'?u.pathname.slice(1):['www.youtube.com','youtube.com','m.youtube.com'].includes(u.hostname)?u.searchParams.get('v')||u.pathname.match(/^\/(?:shorts|embed)\/([^/]+)/)?.[1]:null;if(/^[\w-]{11}$/.test(id||''))embed='https://www.youtube-nocookie.com/embed/'+id;}if(m.tipo==='spotify'&&u.hostname==='open.spotify.com'&&/^\/(track|album|artist|playlist|episode|show)\/[a-zA-Z0-9]+\/?$/.test(u.pathname))embed='https://open.spotify.com/embed'+u.pathname;if(m.tipo==='imagem')return <img className="feed-photo" src={url} alt="Obra publicada" loading="lazy"/>;return embed?<iframe className="media-frame" title={m.tipo} src={embed} loading="lazy" allow="encrypted-media; fullscreen; picture-in-picture" allowFullScreen/>:<a href={url} target="_blank" rel="noopener noreferrer">Abrir mídia</a>}
export default function Feed(){
const [session,S]=useState(null),[view,V]=useState(new URLSearchParams(location.search).get('view')==='artists'?'Artistas':'Início'),[artist,A]=useState(new URLSearchParams(location.search).get('artist')),[category,C]=useState('Todos'),[query,Q]=useState(''),[dark,D]=useState(localStorage.getItem('cult-theme')==='dark'),[data,B]=useState({posts:[],artists:[],cats:[],links:[],likes:[],saved:[],follows:[],comments:[],profiles:[]}),[draft,F]=useState({}),[error,E]=useState(''),[loading,L]=useState(true),[busy,U]=useState(false),[page,P]=useState(0);
const uid=session?.user.id;
useEffect(()=>{const {data:{subscription}}=supabase.auth.onAuthStateChange((_,s)=>S(s));return ()=>subscription.unsubscribe()},[]);
useEffect(()=>{document.documentElement.dataset.theme=dark?'dark':'light';localStorage.setItem('cult-theme',dark?'dark':'light')},[dark]);
useEffect(()=>{const fn=()=>A(new URLSearchParams(location.search).get('artist'));window.addEventListener('popstate',fn);return()=>window.removeEventListener('popstate',fn)},[]);
async function load(){L(true);E('');try{const requests=[supabase.from('publicacoes').select('*,midias(*)').eq('visivel',true).order('criado_em',{ascending:false}).range(page*30,page*30+29),supabase.from('artistas').select('*').eq('aprovado',true),supabase.from('categorias').select('*').order('nome'),supabase.from('artista_categorias').select('*'),supabase.from('comentarios').select('*').order('criado_em'),supabase.from('perfis').select('id,nome,avatar_url,municipio')];if(uid)requests.push(...['curtidas','favoritos','seguidores'].map(t=>supabase.from(t).select('*').eq('usuario_id',uid)));const r=await Promise.all(requests);const err=r.find(x=>x.error);if(err)throw err.error;const [posts,artists,cats,links,comments,profiles,likes,saved,follows]=r.map(x=>x.data);B({posts,artists,cats,links,comments,profiles,likes:likes||[],saved:saved||[],follows:follows||[]})}catch(e){E(e.message)}finally{L(false)}}
useEffect(()=>{load()},[uid,page]);
function open(id){A(id);history.pushState({},'',id?'?artist='+encodeURIComponent(id):location.pathname);window.scrollTo(0,0)}
function select(v){open(null);V(v);C('Todos');Q('');P(0)}
function cats(id){return data.links.filter(x=>x.artista_id===id).map(x=>data.cats.find(c=>c.id===x.categoria_id)?.nome).filter(Boolean)}
function requireUser(){if(uid)return true;location.href=base+'login';return false}
async function action(fn){if(!requireUser()||busy)return;U(true);E('');try{const {error}=await fn();if(error)throw error;await load()}catch(e){E(e.message)}finally{U(false)}}
function toggle(t,col,id,exists){return action(()=>exists?supabase.from(t).delete().eq('usuario_id',uid).eq(col,id):supabase.from(t).insert({usuario_id:uid,[col]:id}))}
const current=data.artists.find(a=>a.id===artist),matches=a=>a&&(category==='Todos'||cats(a.id).includes(category)),filtered=data.posts.filter(p=>{const a=data.artists.find(a=>a.id===p.artista_id);return a&&(category==='Todos'||data.cats.some(c=>c.id===p.categoria_id&&c.nome===category))&&(!artist||artist===a.id)&&`${a.nome_artistico} ${p.titulo} ${p.conteudo||''}`.toLowerCase().includes(query.toLowerCase())&&(view!=='Salvos'||artist||data.saved.some(s=>s.publicacao_id===p.id))});
return <div className="feed-shell"><div className="feed-top"><a className="feed-brand" href={base}>CultSerigy</a><input aria-label="Buscar" placeholder="Buscar artistas e obras" value={query} onChange={e=>Q(e.target.value)}/><button onClick={()=>D(!dark)} aria-label="Alternar tema">{dark?'☀':'☾'}</button>{uid?<><a href={base+'painel-artista'}>Meu painel</a><button onClick={()=>action(()=>supabase.auth.signOut())}>Sair</button></>:<a href={base+'login'}>Entrar</a>}</div><div className="feed-grid"><aside className="feed-nav"><a href={base+'agenda'}>Agenda cultural</a>{uid&&<a href={base+'notificacoes'}>Notificações</a>}{menu.map(([i,v])=><button key={v} className={view===v?'selected':''} onClick={()=>select(v)}><span>{i}</span>{v}</button>)}</aside><section className="feed-content"><div className="feed-heading"><small>COMUNIDADE CULTURAL</small><h1>{current?current.nome_artistico:view==='Início'?'Explore nossa cultura':view}</h1></div>{error&&<p role="alert">{error} <button onClick={load}>Tentar novamente</button></p>}{loading&&<p role="status">Carregando…</p>}{current&&<section className="feed-card"><button className="artist-back" onClick={()=>select('Artistas')}>← Artistas</button>{safe(current.capa_url)&&<img className="artist-cover" src={safe(current.capa_url)} alt="Capa"/>}<div className="feed-body"><h2>{current.nome_artistico}</h2><p>{cats(current.id).join(' · ')}</p><p>{current.bio}</p><div className="artist-buttons">{uid!==current.id&&<button disabled={busy} onClick={()=>toggle('seguidores','artista_id',current.id,data.follows.some(f=>f.artista_id===current.id))}>{data.follows.some(f=>f.artista_id===current.id)?'Seguindo':'Seguir'}</button>}{current.pix&&<button onClick={async()=>{try{await navigator.clipboard.writeText(current.pix);alert('Chave Pix copiada. Confira o destinatário no seu banco.')}catch{E('Não foi possível copiar a chave Pix.')}}}>Copiar Pix</button>}</div>{['instagram','youtube','spotify'].map(k=>safe(current[k])&&<p key={k}><a href={safe(current[k])} target="_blank" rel="noopener noreferrer">{k}</a></p>)}</div></section>}<div className="feed-filters">{['Todos',...data.cats.map(c=>c.nome)].map(c=><button key={c} className={category===c?'selected':''} onClick={()=>C(c)}>{c}</button>)}</div>{!artist&&view==='Categorias'?<div className="feed-gallery">{data.cats.map(c=><button key={c.id} onClick={()=>{V('Explorar');C(c.nome)}}>{c.nome}</button>)}</div>:!artist&&view==='Artistas'?<div className="feed-gallery">{data.artists.filter(a=>matches(a)&&a.nome_artistico.toLowerCase().includes(query.toLowerCase())).map(a=><button key={a.id} onClick={()=>open(a.id)}>{safe(a.capa_url)&&<img src={safe(a.capa_url)} alt=""/>}<strong>{a.nome_artistico}</strong><small>{cats(a.id).join(' · ')}</small></button>)}</div>:<>{!loading&&!filtered.length&&<p>Nenhuma publicação encontrada nesta página.</p>}{filtered.map(p=>{const a=data.artists.find(a=>a.id===p.artista_id),liked=data.likes.some(x=>x.publicacao_id===p.id),saved=data.saved.some(x=>x.publicacao_id===p.id),comments=data.comments.filter(x=>x.publicacao_id===p.id);return <article className="feed-card" key={p.id}><div className="feed-author"><div className="feed-avatar">{a.nome_artistico[0]}</div><div><button className="artist-link" onClick={()=>open(a.id)}>{a.nome_artistico}</button><small>{cats(a.id).join(' · ')}</small></div></div>{p.midias.map(m=><Media key={m.id} m={m}/>)}<div className="feed-body"><div className="feed-actions"><button disabled={busy} aria-label="Curtir" aria-pressed={liked} onClick={()=>toggle('curtidas','publicacao_id',p.id,liked)}>{liked?'♥':'♡'}</button><span>{comments.length} comentários</span><button disabled={busy} aria-label="Salvar" aria-pressed={saved} onClick={()=>toggle('favoritos','publicacao_id',p.id,saved)}>{saved?'★':'☆'}</button></div><small>{data.cats.find(c=>c.id===p.categoria_id)?.nome||'Sem categoria'}</small><h2>{p.titulo}</h2><p style={{whiteSpace:'pre-wrap'}}>{p.conteudo}</p>{comments.map(c=><p className="feed-comment" key={c.id}><strong>{data.profiles.find(x=>x.id===c.usuario_id)?.nome||'Usuário'}:</strong> {c.texto} {c.usuario_id===uid&&<button disabled={busy} onClick={()=>action(()=>supabase.from('comentarios').delete().eq('id',c.id))}>Excluir</button>}</p>)}<form onSubmit={e=>{e.preventDefault();const texto=(draft[p.id]||'').trim();if(texto)action(async()=>{const r=await supabase.from('comentarios').insert({usuario_id:uid,publicacao_id:p.id,texto});if(!r.error)F(d=>({...d,[p.id]:''}));return r})}}><input aria-label="Comentário" maxLength={140} placeholder="Adicionar comentário…" value={draft[p.id]||''} onChange={e=>F(d=>({...d,[p.id]:e.target.value}))}/><button disabled={busy||!(draft[p.id]||'').trim()}>Enviar</button></form><small>{(draft[p.id]||'').length}/140</small></div></article>})}<div className="artist-buttons"><button disabled={!page||loading} onClick={()=>P(p=>p-1)}>Anterior</button><span>Página {page+1}</span><button disabled={data.posts.length<30||loading} onClick={()=>P(p=>p+1)}>Próxima</button></div></>}</section><aside className="feed-right"><h3>Artistas</h3>{data.artists.slice(0,3).map(a=><button key={a.id} onClick={()=>open(a.id)}>{a.nome_artistico}</button>)}<hr/><small>© CultSerigy · Sergipe, Brasil</small></aside></div></div>}
