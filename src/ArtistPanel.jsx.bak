import React,{useEffect,useState} from 'react';
import {supabase,base} from './lib/supabase.js';
const fields=['nome_artistico','bio','instagram','youtube','spotify','pix'];
const labels=['Nome artístico','Biografia','Instagram','YouTube','Spotify','Chave Pix (pública)'];
function ArtistCategories({userId}){
 const [categories,setCategories]=useState([]),[selected,setSelected]=useState([]),[ready,setReady]=useState(false),[saving,setSaving]=useState(false),[notice,setNotice]=useState('');
 useEffect(()=>{let active=true;setReady(false);setNotice('');Promise.all([supabase.from('categorias').select('id,nome').order('nome'),supabase.from('artista_categorias').select('categoria_id').eq('artista_id',userId)]).then(([a,b])=>{if(!active)return;const cats=check(a),links=check(b);setCategories(cats);setSelected(links.map(x=>x.categoria_id));setReady(true)}).catch(e=>{if(active)setNotice(e.message)});return()=>{active=false}},[userId]);
 async function save(e){e.preventDefault();if(!ready||saving)return;setSaving(true);setNotice('');try{check(await supabase.rpc('salvar_categorias_artista',{p_ids:selected}));setNotice('Categorias salvas com sucesso.')}catch(e){setNotice(e.message)}finally{setSaving(false)}}
 return <div className="feed-card panel-form"><h2>Minhas áreas artísticas</h2><p>Selecione todas as categorias que representam seu trabalho.</p><form onSubmit={save}><fieldset disabled={!ready||saving} style={{border:0,padding:0,display:'grid',gridTemplateColumns:'repeat(auto-fit,minmax(140px,1fr))',gap:12}}><legend>Categorias</legend>{categories.map(c=><label key={c.id} style={{display:'flex',flexDirection:'row',alignItems:'center',gap:8}}><input type="checkbox" style={{width:'auto'}} checked={selected.includes(c.id)} onChange={e=>setSelected(old=>e.target.checked?[...old,c.id]:old.filter(id=>id!==c.id))}/>{c.nome}</label>)}</fieldset><p>{selected.length} selecionada(s)</p><button disabled={!ready||saving}>{saving?'Salvando...':'Salvar categorias'}</button></form>{notice&&<p role="status">{notice}</p>}</div>
}
function CategoryField({categories,value=''}){return <label>Categoria<select name="categoria_id" defaultValue={value??''} required><option value="">Selecione uma categoria</option>{categories.map(c=><option key={c.id} value={c.id}>{c.nome}</option>)}</select></label>}
function check(r){if(r.error)throw r.error;return r.data}
export default function ArtistPanel(){
 const [categories,setCategories]=useState([]),[editing,setEditing]=useState(null);
 const [user,setUser]=useState(null),[artist,setArtist]=useState(null),[request,setRequest]=useState(null),[posts,setPosts]=useState([]),[loading,setLoading]=useState(true),[busy,setBusy]=useState(false),[message,setMessage]=useState(''),[dark,setDark]=useState(()=>localStorage.getItem('cult-theme')==='dark');
 useEffect(()=>{document.documentElement.dataset.theme=dark?'dark':'light';localStorage.setItem('cult-theme',dark?'dark':'light')},[dark]);
 async function load(u){setLoading(true);try{setArtist(null);setRequest(null);setPosts([]);if(!u)return;const [a,r,p,c]=await Promise.all([supabase.from('artistas').select('*').eq('id',u.id).maybeSingle(),supabase.from('solicitacoes_artista').select('*').eq('usuario_id',u.id).maybeSingle(),supabase.from('publicacoes').select('*,midias(*)').eq('artista_id',u.id).order('criado_em',{ascending:false}),supabase.from('categorias').select('id,nome').order('nome')]);setCategories(check(c));setArtist(check(a));setRequest(check(r));setPosts(check(p));}catch(e){setMessage(e.message)}finally{setLoading(false)}}
 useEffect(()=>{let active=true;const {data:{subscription}}=supabase.auth.onAuthStateChange((_,s)=>{if(active)setUser(s?.user||null);if(!s&&active)setLoading(false)});return()=>{active=false;subscription.unsubscribe()}},[]);
 useEffect(()=>{if(user?.id)load(user)},[user?.id]);
 async function run(fn){if(busy)return;setBusy(true);setMessage('');try{await fn();await load(user);setMessage('Operação concluída.')}catch(e){setMessage(e.message)}finally{setBusy(false)}}
 async function upload(bucket,file){if(!file?.size)return null;const ext={'image/jpeg':'jpg','image/png':'png','image/webp':'webp'}[file.type];if(!ext||file.size>(bucket==='obras'?10:5)*1024*1024)throw Error('Imagem inválida ou acima do limite.');const path=`${user.id}/${crypto.randomUUID()}.${ext}`;check(await supabase.storage.from(bucket).upload(path,file));return {path,url:supabase.storage.from(bucket).getPublicUrl(path).data.publicUrl}}
 function mediaUrl(raw,type){const u=new URL(raw);if(u.protocol!=='https:'||!(type==='youtube'?['youtube.com','www.youtube.com','youtu.be']:['open.spotify.com']).includes(u.hostname))throw Error('Link de mídia inválido.');return u.href}
 function saveProfile(e){e.preventDefault();const f=new FormData(e.currentTarget);run(async()=>{const values=Object.fromEntries(fields.map(k=>[k,String(f.get(k)||'').trim()]));const cover=await upload('capas',f.get('capa'));try{if(cover)values.capa_url=cover.url;check(await supabase.from('artistas').update(values).eq('id',user.id).select('id').single())}catch(err){if(cover)await supabase.storage.from('capas').remove([cover.path]);throw err}})}
 function publish(e){e.preventDefault();const form=e.currentTarget,f=new FormData(form);run(async()=>{const links=['youtube','spotify'].filter(t=>String(f.get(t)||'').trim()).map(t=>({tipo:t,url:mediaUrl(f.get(t),t)}));const image=await upload('obras',f.get('imagem'));let id;try{const p=check(await supabase.from('publicacoes').insert({artista_id:user.id,categoria_id:Number(f.get('categoria_id')),titulo:String(f.get('titulo')).trim(),conteudo:String(f.get('conteudo')).trim()}).select('id').single());id=p.id;const rows=[...links,...(image?[{tipo:'imagem',url:image.url}]:[])].map(m=>({...m,publicacao_id:id}));if(rows.length)check(await supabase.from('midias').insert(rows));form.reset()}catch(err){if(id)await supabase.from('publicacoes').delete().eq('id',id);if(image)await supabase.storage.from('obras').remove([image.path]);throw err}})}
 function editPost(e,p){e.preventDefault();const f=new FormData(e.currentTarget);run(async()=>{check(await supabase.from('publicacoes').update({titulo:String(f.get('titulo')).trim(),conteudo:String(f.get('conteudo')).trim(),categoria_id:Number(f.get('categoria_id'))}).eq('id',p.id).eq('artista_id',user.id).select('id').single());setEditing(null)})}
 return <div className="feed-shell"><div className="feed-top"><a className="feed-brand" href={base+'feed'}>CultSerigy</a><a href={base+'feed'}>Voltar ao feed</a><button onClick={()=>setDark(!dark)}>{dark?'☀':'☾'}</button></div><section className="artist-panel"><h1>Painel do artista</h1>{message&&<p role="status">{message}</p>}{loading?<p>Carregando...</p>:!user?<a href={base+'login'}>Entre para continuar</a>:!artist?.aprovado?<div className="feed-card panel-form"><h2>Solicitação de artista</h2>{request?<p>Status: {request.status}</p>:<form onSubmit={e=>{e.preventDefault();const descricao=new FormData(e.currentTarget).get('descricao');run(async()=>check(await supabase.from('solicitacoes_artista').insert({usuario_id:user.id,descricao})))}}><label>Conte sobre seu trabalho em Sergipe<textarea name="descricao" required minLength={10} maxLength={1000}/></label><button disabled={busy}>Solicitar aprovação</button></form>}<p>A publicação depende de aprovação administrativa.</p></div>:<><div className="feed-card panel-form"><h2>Meu perfil</h2><form key={artist.capa_url||'perfil'} onSubmit={saveProfile}>{fields.map((k,i)=><label key={k}>{labels[i]}{k==='bio'?<textarea name={k} defaultValue={artist[k]||''} maxLength={2000}/>:<input name={k} defaultValue={artist[k]||''} required={k==='nome_artistico'} maxLength={300}/>}</label>)}<label>Capa (até 5 MB)<input type="file" name="capa" accept="image/jpeg,image/png,image/webp"/></label><button disabled={busy}>Salvar perfil</button></form></div><ArtistCategories key={user.id} userId={user.id}/><div className="feed-card panel-form"><h2>Nova publicação</h2><form onSubmit={publish}><CategoryField categories={categories}/><label>Título<input name="titulo" required maxLength={150}/></label><label>Texto<textarea name="conteudo" maxLength={20000}/></label><label>Imagem (até 10 MB)<input name="imagem" type="file" accept="image/jpeg,image/png,image/webp"/></label><label>Link YouTube<input name="youtube" type="url"/></label><label>Link Spotify<input name="spotify" type="url"/></label><button disabled={busy}>Publicar</button></form></div><div className="feed-card panel-form"><h2>Minhas publicações</h2>{!posts.length&&<p>Nenhuma publicação.</p>}{posts.map(p=><article key={p.id}><h3>{p.titulo}</h3><small>{categories.find(c=>c.id===p.categoria_id)?.nome||'Sem categoria'}</small><p>{p.conteudo}</p>{editing===p.id?<form onSubmit={e=>editPost(e,p)}><CategoryField categories={categories} value={p.categoria_id}/><label>Título<input name="titulo" defaultValue={p.titulo} required maxLength={150}/></label><label>Texto<textarea name="conteudo" defaultValue={p.conteudo||''} maxLength={20000}/></label><button disabled={busy}>Salvar alterações</button><button type="button" disabled={busy} onClick={()=>setEditing(null)}>Cancelar</button></form>:<button disabled={busy} onClick={()=>setEditing(p.id)}>Editar</button>} <button disabled={busy} onClick={()=>run(async()=>check(await supabase.from('publicacoes').update({visivel:!p.visivel}).eq('id',p.id).select('id').single()))}>{p.visivel?'Ocultar':'Exibir'}</button> <button disabled={busy} onClick={()=>{if(confirm('Excluir publicação?'))run(async()=>check(await supabase.from('publicacoes').delete().eq('id',p.id)))}}>Excluir</button></article>)}</div></>}</section></div>
}
